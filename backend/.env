# Copy to .env and fill in your real key. Get one at openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model slugs from openrouter.ai/models — swap freely without touching code
CHAT_MODEL=openai/gpt-4o-mini
EXTRACT_MODEL=openai/gpt-4o-mini

MAX_EXTRACT_RETRIES=2
LOG_FILE=logs/requests.jsonl